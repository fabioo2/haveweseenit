# Copy to .env.local and fill in. These values end up readable in the built
# bundle — the passphrase is the only real secret, and it never lives here.

# TMDB "API Read Access Token" (the long eyJ... v4 bearer token)
VITE_TMDB_TOKEN=

# Apps Script web app URL, ending in /exec
VITE_SCRIPT_URL=

# Display names for the two people (optional; default to Person 1 / Person 2)
VITE_PERSON_1_NAME=
VITE_PERSON_2_NAME=
